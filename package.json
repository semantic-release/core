{
  "name": "@semantic-release/core",
  "version": "0.0.0-development",
  "description": "Core orchestration engine for semantic-release",
  "type": "module",
  "author": "Olabode Lawal-Shittabey (http://babblebey.dev)",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "files": [
    "lib",
    "index.js",
    "index.d.ts"
  ],
  "scripts": {
    "start": "node index.js",
    "lint": "npm run lint:prettier",
    "lint:core": "npm run lint",
    "lint:prettier": "prettier --check \"*.{js,json,md}\"",
    "lint:prettier:fix": "prettier --write \"*.{js,json,md}\"",
    "format": "npm run lint:prettier:fix",
    "test": "node --test",
    "test:core": "npm run test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/semantic-release/core.git"
  },
  "keywords": [
    "javascript",
    "node"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/semantic-release/core/issues"
  },
  "homepage": "https://github.com/semantic-release/core#readme",
  "dependencies": {
    "@semantic-release/error": "^4.0.0",
    "aggregate-error": "^5.0.0",
    "cosmiconfig": "^9.0.0",
    "debug": "^4.0.0",
    "env-ci": "^11.0.0",
    "execa": "^9.0.0",
    "figures": "^6.0.0",
    "get-stream": "^6.0.0",
    "git-log-parser": "^1.2.0",
    "hook-std": "^4.0.0",
    "hosted-git-info": "^9.0.0",
    "import-from-esm": "^2.0.0",
    "lodash-es": "^4.17.21",
    "micromatch": "^4.0.2",
    "p-each-series": "^3.0.0",
    "p-reduce": "^3.0.0",
    "read-package-up": "^12.0.0",
    "resolve-from": "^5.0.0",
    "semver": "^7.3.2",
    "signale": "^1.2.1"
  },
  "prettier": {
    "printWidth": 120,
    "trailingComma": "es5"
  },
  "devDependencies": {
    "prettier": "3.8.3"
  }
}
